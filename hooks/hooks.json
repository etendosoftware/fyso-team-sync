{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh agent_dispatch",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh session_start",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "tmpf=$(mktemp /tmp/fyso-hb-XXXXXX.json); cat > \"$tmpf\" 2>/dev/null; nohup ${CLAUDE_PLUGIN_ROOT}/hooks/heartbeat.sh \"$tmpf\" >/dev/null 2>&1 &",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-team-updates.sh",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh usage_limit_check",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh subagent_start",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh subagent_stop",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/tracking.sh session_update",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "kill $(cat ~/.fyso/heartbeat.pid 2>/dev/null) 2>/dev/null; true",
            "timeout": 2000
          }
        ]
      }
    ]
  }
}
